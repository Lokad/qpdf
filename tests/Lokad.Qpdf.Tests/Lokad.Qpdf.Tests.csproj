<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="QpdfSourceRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))" />
    <QpdfFixture Include="../Fixtures/security-*.json;../Fixtures/*.pdf;../Fixtures/cmyk-8x8.jpg;../Fixtures/manifest.json" />
    <None Include="@(QpdfFixture)" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Lokad.Qpdf.PackageConsumer/RecordingMemoryBudget.cs" Link="Support/RecordingMemoryBudget.cs" />
    <EmbeddedResource Include="Content/InlineImageNativeCases.json" />
    <EmbeddedResource Include="Pages/RangeGroupNativeCases.json" />
    <EmbeddedResource Include="Writing/LinearizedHintNativeCases.json" />
    <EmbeddedResource Include="Writing/LinearizedPageModeCases.json" />
    <EmbeddedResource Include="Writing/DocumentOpenHintCases.json" />
    <EmbeddedResource Include="Inspection/LinearizationCheckCases.json" />
    <EmbeddedResource Include="Filters/PredictorApplicabilityCases.json" />
    <EmbeddedResource Include="Writing/AttachmentDateCases.json" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="All" />
    <PackageReference Include="xunit" PrivateAssets="All" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="All" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Lokad.Image" />
    <ProjectReference Include="../../src/Lokad.Qpdf/Lokad.Qpdf.csproj" />
    <ProjectReference Include="../../tools/QpdfProbe/QpdfProbe.csproj" />
    <Using Include="Xunit" />
    <None Include="../Compatibility/options.json" Link="Compatibility/options.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Compatibility/oracle-evidence.json" Link="Compatibility/oracle-evidence.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../tools/Lokad.Qpdf.Image/Lokad.Qpdf.Image.csproj" />
  </ItemGroup>
  <Target Name="StageCompressedFixtures" BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <QpdfFixtureStageDirectory Condition="'$(QpdfFixtureStageDirectory)' == ''">$(TargetDir)Fixtures</QpdfFixtureStageDirectory>
    </PropertyGroup>
    <Unzip SourceFiles="$(MSBuildProjectDirectory)/../Fixtures/security-r4-generations.pdf.zip"
           DestinationFolder="$(QpdfFixtureStageDirectory)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <FileWrites Include="$(QpdfFixtureStageDirectory)/security-r4-generations.pdf" />
    </ItemGroup>
  </Target>
  <Target Name="StageFixtureCorpus" DependsOnTargets="StageCompressedFixtures"
          Condition="'$(TargetFramework)' != ''">
    <Copy SourceFiles="@(QpdfFixture)" DestinationFolder="$(QpdfFixtureStageDirectory)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
