<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Clean package consumer: restores the PACKED Lokad.qpdf NuGet (never a
    project reference) and exercises only the public embedding surface.
    Excluded from the solution; the verifier copies this project and its lock
    into a fresh run after pack, binding only the rebuilt local artifact hash.
    Bump the central Lokad.qpdf version together with src/Lokad.Qpdf releases.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackageConsumer>true</IsPackageConsumer>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PackageConsumer</RootNamespace>
    <AssemblyName>Lokad.Qpdf.PackageConsumer</AssemblyName>
    <Description>Clean consumer smoke for the packed Lokad.qpdf package. Not shipped.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lokad.qpdf" />
    <EmbeddedResource Include="../Fixtures/security-r6-ascii.pdf" LogicalName="Fixtures.security-r6-ascii.pdf" />
    <EmbeddedResource Include="../Fixtures/security-r5-ascii.pdf" LogicalName="Fixtures.security-r5-ascii.pdf" />
    <EmbeddedResource Include="../Fixtures/security-r6-empty.pdf" LogicalName="Fixtures.security-r6-empty.pdf" />
    <EmbeddedResource Include="../Fixtures/security-r4-pdfdoc.pdf" LogicalName="Fixtures.security-r4-pdfdoc.pdf" />
    <EmbeddedResource Include="../Fixtures/security-r4-attachment.pdf" LogicalName="Fixtures.security-r4-attachment.pdf" />
  </ItemGroup>
</Project>
