<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Local feed first (populated by pack), then nuget.org for approved dependencies. Paths are relative to this file. -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
