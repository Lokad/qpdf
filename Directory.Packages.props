<Project>
  <ItemGroup>
    <!-- Development-only codec and fixture dependency; never shipped in the core package. -->
    <PackageVersion Include="Lokad.Image" Version="[0.2.0]" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.111" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Pinned independent PDF reader for development validation only. Never a runtime dependency. -->
    <PackageVersion Include="PdfPig" Version="[0.1.16]" />
    <!-- Development-only benchmarking harness. Never a runtime dependency and never packed. -->
    <PackageVersion Include="BenchmarkDotNet" Version="[0.15.8]" />
    <!-- In-repo consumer pins the built package; bump together with src/Lokad.Qpdf releases. -->
    <PackageVersion Include="Lokad.qpdf" Version="0.1.0-alpha.1" />
  </ItemGroup>
</Project>

