<Project>
  <ItemGroup>
    <!-- The closed range also pins the dependency in the produced NuGet package. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="[3.1.12]" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.111" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Pinned independent PDF reader for development validation only. Never a runtime dependency. -->
    <PackageVersion Include="PdfPig" Version="[0.1.16]" />
  </ItemGroup>
</Project>
