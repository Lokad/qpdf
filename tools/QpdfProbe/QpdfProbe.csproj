<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsQpdfProbeTool>true</IsQpdfProbeTool>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lokad.Qpdf.Probe</RootNamespace>
    <AssemblyName>QpdfProbe</AssemblyName>
    <Description>Developer-only qpdf oracle and independent validation runner. Not part of the shipped package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <ProjectReference Include="..\..\src\Lokad.Qpdf\Lokad.Qpdf.csproj" />
    <ProjectReference Include="../../tools/Lokad.Qpdf.ImageSharp/Lokad.Qpdf.ImageSharp.csproj" />
  </ItemGroup>
</Project>