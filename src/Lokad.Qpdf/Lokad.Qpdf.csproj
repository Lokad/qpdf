<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Lokad.qpdf</PackageId>
    <Title>Lokad.qpdf</Title>
    <Description>Managed, host-mediated .NET implementation of qpdf's non-cryptographic PDF structural operations: strict reading, page selection and merge, writer controls, content transforms, overlays, appearances, JPEG processing, QDF, and linearization. Compatibility target: qpdf 12.4.2, non-cryptographic subset only.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Copyright>Copyright (c) 2026 Lokad</Copyright>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <RootNamespace>Lokad.Qpdf</RootNamespace>
    <AssemblyName>Lokad.Qpdf</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Managed non-cryptographic PDF structural operations, qualified against qpdf 12.4.2. CMYK/YCCK decoding and Zopfli are unavailable; see docs/SUPPORTED-PROFILE.md and docs/COMPATIBILITY.md for scope and differences.</PackageReleaseNotes>
    <PackageTags>pdf;qpdf;structural-processing;embedding;managed</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>../../artifacts/nuget/</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lokad.Qpdf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md;../../LICENSE.txt;../../CHANGELOG.md;../../icon.png"
          Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>


