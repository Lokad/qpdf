<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Lokad.qpdf</PackageId>
    <Title>Lokad.qpdf</Title>
    <Description>Managed .NET library for splitting, merging, reordering, checking and rewriting PDFs, including Standard password security R2-R6 and signed-page extraction. No runtime NuGet dependencies; JPEG processing uses a caller-supplied codec. Compatibility target: qpdf 12.4.2 structural operations.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Copyright>Copyright (c) 2026 Lokad</Copyright>
    <Version>0.2.0-dev.7</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <RootNamespace>Lokad.Qpdf</RootNamespace>
    <AssemblyName>Lokad.Qpdf</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>PDF JSON creation and update, transformed inspection reports, and AES-256 R6 output. See CHANGELOG.md.</PackageReleaseNotes>
    <PackageTags>pdf;qpdf;structural-processing;embedding;managed</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>../../artifacts/nuget/</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lokad.Qpdf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md;../../LICENSE.txt;../../CHANGELOG.md;../../icon.png"
          Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../docs/*.md" Exclude="../../docs/COMPATIBILITY.md;../../docs/SUPPORTED-PROFILE.md"
          Pack="true" PackagePath="docs/" Visible="false" />
  </ItemGroup>

  <Target Name="PreparePackagedCompatibilityGuides" BeforeTargets="_GetPackageFiles"
          DependsOnTargets="_InitializeNuspecRepositoryInformationProperties">
    <Exec Condition="'$(RepositoryCommit)' == ''" Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="RepositoryCommit" />
    </Exec>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RepositoryCommit)', '^[0-9a-f]{40}$'))"
           Text="Packing the compatibility guides requires a repository commit." />
    <PropertyGroup>
      <_PackagedGuides>$(BaseIntermediateOutputPath)package-docs/</_PackagedGuides>
      <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/Lokad/qpdf</RepositoryUrl>
      <_InventoryLink>https://github.com/Lokad/qpdf/blob/$(RepositoryCommit)/tests/Compatibility/options.json</_InventoryLink>
    </PropertyGroup>
    <ItemGroup>
      <_CompatibilityGuide Include="../../docs/COMPATIBILITY.md;../../docs/SUPPORTED-PROFILE.md" />
    </ItemGroup>
    <MakeDir Directories="$(_PackagedGuides)" />
    <WriteLinesToFile File="$(_PackagedGuides)%(_CompatibilityGuide.Filename)%(_CompatibilityGuide.Extension)"
                      Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_CompatibilityGuide.FullPath)').Replace('../tests/Compatibility/options.json', '$(_InventoryLink)').TrimEnd())))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="@(_CompatibilityGuide->'$(_PackagedGuides)%(Filename)%(Extension)')"
            Pack="true" PackagePath="docs/" Visible="false" />
    </ItemGroup>
  </Target>
</Project>


