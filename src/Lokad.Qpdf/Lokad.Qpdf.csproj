<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Lokad.qpdf</PackageId>
    <Title>Lokad.qpdf</Title>
    <Description>Managed .NET library for splitting, merging, reordering, checking and rewriting PDFs, with no runtime NuGet dependencies. JPEG processing uses a caller-supplied codec. Compatibility target: qpdf 12.4.2, non-cryptographic subset.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Copyright>Copyright (c) 2026 Lokad</Copyright>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <RootNamespace>Lokad.Qpdf</RootNamespace>
    <AssemblyName>Lokad.Qpdf</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Managed non-cryptographic PDF operations targeting qpdf 12.4.2. JPEG processing requires a caller-supplied codec; the core has no runtime package dependencies. CMYK/YCCK decoding and Zopfli remain unavailable; see https://github.com/Lokad/qpdf/blob/master/docs/SUPPORTED-PROFILE.md and https://github.com/Lokad/qpdf/blob/master/docs/COMPATIBILITY.md.</PackageReleaseNotes>
    <PackageTags>pdf;qpdf;structural-processing;embedding;managed</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>../../artifacts/nuget/</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lokad.Qpdf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md;../../LICENSE.txt;../../CHANGELOG.md;../../icon.png"
          Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>


