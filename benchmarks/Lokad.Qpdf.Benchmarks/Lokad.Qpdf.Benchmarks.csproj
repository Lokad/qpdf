<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsQpdfBenchmarkTool>true</IsQpdfBenchmarkTool>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lokad.Qpdf.Benchmarks</RootNamespace>
    <AssemblyName>Lokad.Qpdf.Benchmarks</AssemblyName>
    <Description>Developer-only resource-counter and benchmark harness. Not part of the shipped package.</Description>
  </PropertyGroup>

  <!-- Compile the same measurement driver against a preserved pre-hook build. -->
  <PropertyGroup Condition="'$(QpdfMemoryBaseline)' == 'true'">
    <DefineConstants>$(DefineConstants);QPDF_MEMORY_BASELINE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(QpdfMemoryBaseline)' != 'true'">
    <Compile Include="../../tests/Lokad.Qpdf.PackageConsumer/RecordingMemoryBudget.cs" Link="RecordingMemoryBudget.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <ProjectReference Include="..\..\src\Lokad.Qpdf\Lokad.Qpdf.csproj" />
    <ProjectReference Include="../../tools/Lokad.Qpdf.ImageSharp/Lokad.Qpdf.ImageSharp.csproj" />
  </ItemGroup>
</Project>
